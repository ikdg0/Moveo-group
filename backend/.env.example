# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moveo

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=info@moveogroup.be

# CORS — comma-separated origins for the mobile app dev tunnel (Expo)
CORS_ORIGINS=*
